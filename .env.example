# Application Settings
APP_NAME="Stress and Trauma Detection Backend"
APP_VERSION="1.0.0"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Audio Constraints
MAX_AUDIO_SIZE_BYTES=26214400 # 25 MB
ALLOWED_AUDIO_EXTENSIONS=[".wav", ".mp3", ".ogg", ".flac", ".m4a", ".aac", ".webm"]
TARGET_SAMPLE_RATE=16000
TARGET_CHANNELS=1
TARGET_BIT_DEPTH=16

# Voice Model Artifacts
VOICE_SCALER_PATH="models/voice/scaler.pkl"
VOICE_PCA_PATH="models/voice/pca.pkl"
VOICE_LABEL_ENCODER_PATH="models/voice/label_encoder.pkl"
VOICE_CLASSIFIER_PATH="models/voice/model.pkl"

# Chat Model Artifacts
CHAT_SCALER_PATH="models/chat/scaler.pkl"
CHAT_LABEL_ENCODER_PATH="models/chat/label_encoder.pkl"
CHAT_CLASSIFIER_PATH="models/chat/model.pkl"

# Pretrained Model Checkpoints
WAV2VEC2_MODEL_ID="facebook/wav2vec2-xls-r-300m"
MURIL_MODEL_ID="google/muril-base-cased"
INDIC_CONFORMER_MODEL_ID="ai4bharat/indicconformer_asr"

# OpenSMILE Feature Configuration (e.g. eGeMAPSv02, ComParE_2016)
OPENSMILE_FEATURE_SET="eGeMAPSv02"
OPENSMILE_FEATURE_LEVEL="Functionals"

# Strict Model Loading (true = crash on startup if missing; false = allow startup, fail on inference)
STRICT_MODEL_LOADING=false
